{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.AspNetCore.DataProtection": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "AutoMigrate": true
  },
  "Arena": {
    "GlobalConcurrencyLimit": 8,
    "MaxRetryAttempts": 10,
    "BackoffBaseMilliseconds": 5,
    "BackoffMaxMilliseconds": 200,
    "MaxConcurrentRuns": 2,
    "MaxRequestsPerRun": 100,
    "MaxConcurrencyPerRun": 16,
    "SandboxLifetimeDays": 30,
    "EnableReset": true
  },
  "Proof": {
    "Repository": "",
    "WorkflowFile": ".github/workflows/ci.yml",
    "CoverageThresholdPercent": 75,
    "MaxEvidenceAgeHours": 24,
    "CacheSeconds": 60,
    "GitHubApiBaseUrl": "https://api.github.com",
    "Fly": {
      "AppName": "",
      "ApiBaseUrl": "https://api.machines.dev",
      "TimeoutSeconds": 5
    }
  }
}
