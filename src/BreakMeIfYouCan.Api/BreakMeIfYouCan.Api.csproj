<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>BreakMeIfYouCan.Api</RootNamespace>
    <UserSecretsId>break-me-if-you-can-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BreakMeIfYouCan.Evidence\BreakMeIfYouCan.Evidence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="CommitSha" Value="$(CommitSha)" />
  </ItemGroup>

</Project>